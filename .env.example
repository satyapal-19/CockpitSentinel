# Storage paths — leave empty to use the repository directory as default.
# Set these only if you want data/models stored outside the repo.
COCKPIT_DATA_ROOT=
COCKPIT_MODELS_ROOT=
MLFLOW_TRACKING_URI=
LOG_LEVEL=INFO
WEBCAM_INDEX=0
KAGGLE_USERNAME=
KAGGLE_KEY=

# Database configuration (MongoDB Atlas or fallback local SQLite)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/CockpitSentinel?retryWrites=true&w=majority
DATABASE_BACKEND=auto
DASHBOARD_PORT=8000
